{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "Minimal example",
  "description": "The smallest useful schema: an object with two properties.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "age": {
      "type": "integer"
    }
  },
  "required": ["name"]
}
